{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vision-research-monitor/github-discovery.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "window", "search", "query_families", "venue_search"],
  "properties": {
    "version": {"const": 1},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_lookback_hours", "overlap_minutes", "max_catchup_hours", "minimum_split_minutes"],
      "properties": {
        "initial_lookback_hours": {"type": "integer", "minimum": 1, "maximum": 168},
        "overlap_minutes": {"type": "integer", "minimum": 0, "maximum": 720},
        "max_catchup_hours": {"type": "integer", "minimum": 1, "maximum": 720},
        "minimum_split_minutes": {"type": "integer", "minimum": 1, "maximum": 1440}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_page", "max_pages_per_slice", "request_interval_seconds", "public_only",
        "exclude_archived", "exclude_forks", "locations", "query_evidence_score", "minimum_topic_relevance_score",
        "minimum_venue_relevance_score", "pushed_minimum_stars",
        "max_readme_enrichments_per_run", "vision_context_terms"
      ],
      "properties": {
        "per_page": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_pages_per_slice": {"type": "integer", "minimum": 1, "maximum": 10},
        "request_interval_seconds": {"type": "number", "minimum": 0},
        "public_only": {"type": "boolean"},
        "exclude_archived": {"type": "boolean"},
        "exclude_forks": {"type": "boolean"},
        "locations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["name", "description", "topics", "readme"]}
        },
        "query_evidence_score": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_topic_relevance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_venue_relevance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "pushed_minimum_stars": {"type": "integer", "minimum": 0},
        "max_readme_enrichments_per_run": {"type": "integer", "minimum": 0, "maximum": 1000},
        "vision_context_terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "query_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "queries"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "queries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "topics"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
                "text": {"type": "string", "minLength": 1},
                "topics": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
                },
                "requires_vision_context": {"type": "boolean", "default": false},
                "modes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"enum": ["created", "pushed"]}
                }
              }
            }
          }
        }
      }
    },
    "venue_search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "priorities", "year_offsets", "modes"],
      "properties": {
        "enabled": {"type": "boolean"},
        "priorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["core", "secondary"]}
        },
        "venue_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
        },
        "year_offsets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": -5, "maximum": 5}
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["created", "pushed"]}
        }
      }
    }
  }
}
