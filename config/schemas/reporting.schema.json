{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reporting.schema.json",
  "title": "Ranking and reporting configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "timezone",
    "day_boundary_hour",
    "ranking",
    "report"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "day_boundary_hour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_total_score",
        "minimum_github_repository_research_score",
        "weights",
        "source_priority_defaults",
        "venue_priority",
        "relevance_fallback_with_topics",
        "freshness_half_life_hours",
        "popularity_reference_delta",
        "novelty"
      ],
      "properties": {
        "minimum_total_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_github_repository_research_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "priority",
            "relevance",
            "freshness",
            "novelty",
            "popularity"
          ],
          "properties": {
            "priority": {
              "type": "number",
              "minimum": 0
            },
            "relevance": {
              "type": "number",
              "minimum": 0
            },
            "freshness": {
              "type": "number",
              "minimum": 0
            },
            "novelty": {
              "type": "number",
              "minimum": 0
            },
            "popularity": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "source_priority_defaults": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "venue_priority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "core",
            "secondary"
          ],
          "properties": {
            "core": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "secondary": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "relevance_fallback_with_topics": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "freshness_half_life_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "popularity_reference_delta": {
          "type": "integer",
          "minimum": 1
        },
        "novelty": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            ]
          },
          "required": [
            "repository",
            "paper",
            "release",
            "tag",
            "commit",
            "event",
            "model",
            "project",
            "article",
            "actions"
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "include_score",
        "summary_max_characters",
        "section_limits"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "include_score": {
          "type": "boolean"
        },
        "summary_max_characters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "section_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepted_papers",
            "new_papers",
            "new_repositories",
            "models_and_demos",
            "research_announcements",
            "project_updates",
            "other"
          ],
          "properties": {
            "accepted_papers": {
              "type": "integer",
              "minimum": 0
            },
            "new_papers": {
              "type": "integer",
              "minimum": 0
            },
            "new_repositories": {
              "type": "integer",
              "minimum": 0
            },
            "project_updates": {
              "type": "integer",
              "minimum": 0
            },
            "other": {
              "type": "integer",
              "minimum": 0
            },
            "models_and_demos": {
              "type": "integer",
              "minimum": 0
            },
            "research_announcements": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
