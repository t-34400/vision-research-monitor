{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/analytics.schema.json",
  "title": "Long-term analytics configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "history_days",
    "trend_windows_days",
    "momentum",
    "growth",
    "recurring_entities",
    "archive"
  ],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "history_days": {"type": "integer", "minimum": 14},
    "trend_windows_days": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "momentum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoothing", "minimum_current_entities", "top_topics_per_window"],
      "properties": {
        "smoothing": {"type": "number", "exclusiveMinimum": 0},
        "minimum_current_entities": {"type": "integer", "minimum": 1},
        "top_topics_per_window": {"type": "integer", "minimum": 1}
      }
    },
    "growth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_window_days"],
      "properties": {
        "primary_window_days": {"type": "integer", "minimum": 1}
      }
    },
    "recurring_entities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lookback_days", "minimum_activity_items", "minimum_active_days", "limit"],
      "properties": {
        "lookback_days": {"type": "integer", "minimum": 2},
        "minimum_activity_items": {"type": "integer", "minimum": 2},
        "minimum_active_days": {"type": "integer", "minimum": 2},
        "limit": {"type": "integer", "minimum": 1}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_summary_characters", "default_search_limit", "maximum_search_limit"],
      "properties": {
        "maximum_summary_characters": {"type": "integer", "minimum": 0},
        "default_search_limit": {"type": "integer", "minimum": 1},
        "maximum_search_limit": {"type": "integer", "minimum": 1}
      }
    }
  }
}
