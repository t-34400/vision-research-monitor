{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/watchlist.schema.json",
  "title": "GitHub watchlist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "account_discovery",
    "accounts",
    "repositories"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "account_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlap_minutes", "max_pages_per_run"],
      "properties": {
        "overlap_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 720
        },
        "max_pages_per_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "login",
          "type",
          "priority"
        ],
        "properties": {
          "login": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
          },
          "type": {
            "enum": [
              "organization",
              "user"
            ]
          },
          "priority": {
            "enum": [
              "high",
              "normal"
            ]
          },
          "topic_filter_required": {
            "type": "boolean",
            "default": false
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "priority"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "priority": {
            "enum": [
              "high",
              "normal"
            ]
          },
          "topics": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}
