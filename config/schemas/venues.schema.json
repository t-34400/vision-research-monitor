{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/venues.schema.json",
  "title": "Academic venue registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "venues"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "venues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "domains",
          "priority",
          "aliases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "vision",
                "machine_learning",
                "graphics",
                "robotics",
                "xr"
              ]
            }
          },
          "priority": {
            "enum": [
              "core",
              "secondary"
            ]
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "openreview",
                "cvf",
                "publisher",
                "homepage"
              ]
            }
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}
