{"authors": [], "discovered_at": "2026-08-28T06:51:28.569742Z", "id": "github:release:291498455:release:377639308", "kind": "release", "matched_terms": [], "metadata": {"action": "released", "draft": false, "forks": 423, "prerelease": false, "stars": 3436, "stars_delta": 5, "tag_name": "v3.6.1"}, "organization": "roflcoopter", "priority": {"source": 0.5}, "published_at": "2026-08-27T07:37:17Z", "related_items": [], "scores": {}, "source": "github", "source_id": "291498455:release:377639308", "summary": "This is a patch release to fix an error with the `drawtext` FFmpeg filter.\r\nWith the update to FFmpeg 8.1, a dependency on `Harfbuzz` was introduced which was missing during build time so the filter was silently dropped.\r\n\r\nNo changes in the runtime code of Viseron, this is simply a re-tag of `3.6.0` to trigger new builds which will pick up the latest FFmpeg build.\r\n\r\nIf you have any questions, issues or just want to share your setup, please join our new [Discord server](https://discord.gg/MxP5xpyvk7)!", "title": "roflcoopter/viseron 3.6.1 - FFmpeg drawtext filter fix", "topics": ["object_detection", "open_vocabulary_recognition", "video_understanding"], "updated_at": "2026-08-27T07:37:17Z", "url": "https://github.com/roflcoopter/viseron/releases/tag/v3.6.1", "venue": null}
